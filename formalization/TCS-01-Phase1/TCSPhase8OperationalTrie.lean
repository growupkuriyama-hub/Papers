import TCSPhase8CompleteEncoding
import TCSPhase8TrieRuleBridge
import TCSPhase8AllCandidates
import TCSPhase8EncodedLength

/-!
Concrete insertion of every tagged item emitted by the List grammar into
the instrumented BitTrie. Both the key-list and the trie are executable:
no mathematical Finset conversion participates in the insertion.
-/
namespace TCSPhase8

def buildItemTrie {Alphabet M : Type*}
    [Fintype Alphabet] [DecidableEq Alphabet]
    [Monoid M] [DecidableEq M]
    (c : LetterNumbering Alphabet) (t : LetterTable Alphabet M)
    (sample : List (List Alphabet)) : BitTrie × Nat :=
  BitTrie.insertManyCount
    ((emitAllRecItems t sample).map (encodeRecItem c)) BitTrie.empty

/-- Exact key membership of the trie generated by the *real* six-field
candidate emitter, even if the raw List contains duplicate productions. -/
theorem buildItemTrie_contains_iff {Alphabet M : Type*}
    [Fintype Alphabet] [DecidableEq Alphabet]
    [Monoid M] [DecidableEq M]
    (c : LetterNumbering Alphabet) (t : LetterTable Alphabet M)
    (sample : List (List Alphabet)) (r : RecItem Alphabet) :
    BitTrie.contains (encodeRecItem c r)
      (buildItemTrie c t sample).1 = true ↔
        r ∈ emitAllRecItems t sample := by
  exact BitTrie.contains_encoded_list_iff
    (encodeRecItem c) (encodeRecItem_injective c)
      (emitAllRecItems t sample) r

/-- The same real execution exposes exactly the total number of
instrumented bit visits, without treating list length as runtime. -/
theorem buildItemTrie_steps {Alphabet M : Type*}
    [Fintype Alphabet] [DecidableEq Alphabet]
    [Monoid M] [DecidableEq M]
    (c : LetterNumbering Alphabet) (t : LetterTable Alphabet M)
    (sample : List (List Alphabet)) :
    (buildItemTrie c t sample).2 =
      ((emitAllRecItems t sample).map
        (fun r => (encodeRecItem c r).length + 1)).sum := by
  exact BitTrie.encoded_list_steps (encodeRecItem c)
    (emitAllRecItems t sample)

#print axioms TCSPhase8.buildItemTrie_contains_iff
#print axioms TCSPhase8.buildItemTrie_steps
end TCSPhase8
