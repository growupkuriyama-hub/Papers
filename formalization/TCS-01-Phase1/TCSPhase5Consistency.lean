import TCSPhase5Soundness

namespace TCSPhase5

variable {Alphabet M : Type*}
variable [DecidableEq Alphabet] [Monoid M]

/-- Every *positive observed factor* reconstructs itself using only
B and L. Induction is on word length via the list tail. -/
theorem observed_factor_derives_self
    (h : Word Alphabet →* M)
    (K : Finset (Word Alphabet)) :
    ∀ x : Word Alphabet, ObservedFactor K x →
      RecFactorDerives h K x x := by
  intro x
  induction x with
  | nil =>
      intro hobs
      exact False.elim (hobs.1 rfl)
  | cons a xs ih =>
      intro hobs
      cases xs with
      | nil =>
          exact RecFactorDerives.lexical hobs
      | cons b bs =>
          have hone : ObservedFactor K [a] :=
            observed_of_infix hobs (by simp) ⟨[], b :: bs, rfl⟩
          have htail : ObservedFactor K (b :: bs) :=
            observed_of_infix hobs (by simp) ⟨[a], [], by simp⟩
          have hhead : RecFactorDerives h K [a] [a] :=
            RecFactorDerives.lexical hone
          have hrest : RecFactorDerives h K (b :: bs) (b :: bs) :=
            ih htail
          have hb := RecFactorDerives.binary hone htail
            (by simpa using hobs) hhead hrest
          simpa using hb

/-- Every finite sample (including epsilon and the empty sample) is
generated by its actual B/U/L/S reconstruction grammar. -/
theorem rec_sample_consistency
    (h : Word Alphabet →* M) (K : Finset (Word Alphabet)) :
    (↑K : Set (Word Alphabet)) ⊆ RecLanguage h K := by
  intro w hw
  change RecStartDerives h K w
  by_cases hne : w = []
  · subst w
    exact RecStartDerives.empty hw
  · exact RecStartDerives.root hw hne
      (observed_factor_derives_self h K w
        (sample_word_observed hw hne))

#print axioms TCSPhase5.observed_factor_derives_self
#print axioms TCSPhase5.rec_sample_consistency

end TCSPhase5
