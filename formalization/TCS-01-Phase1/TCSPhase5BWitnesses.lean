import TCSPhase5BFiniteTyped

/-! The four actual finite positive witness families from equation (W).
For now a shortest-length representative and a minimum-total-length
context are used; shortlex tie-breaking is audited separately. -/
namespace TCSPhase5B
open TCSPhase5
variable {Alphabet NT M : Type*}
variable [Fintype Alphabet] [DecidableEq Alphabet]
variable [Fintype NT] [DecidableEq NT]
variable [Monoid M] [Fintype M] [DecidableEq M]

noncomputable def wrapYield (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) (A : NT) (μ : M)
    (w : List Alphabet) : List Alphabet :=
  (chosenContext G h A μ).1 ++ w ++ (chosenContext G h A μ).2

noncomputable def WitnessSymbols (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) : Finset (List Alphabet) :=
  (finiteTypedRefinement G h).symbols.image
    (fun p => wrapYield G h p.1 p.2 (chosenYield G h p.1 p.2))

noncomputable def WitnessLexical (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) : Finset (List Alphabet) :=
  (finiteTypedRefinement G h).terminalRules.image
    (fun p => wrapYield G h p.1.1 p.1.2 [p.2])

noncomputable def WitnessBinary (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) : Finset (List Alphabet) :=
  (finiteTypedRefinement G h).binaryRules.image
    (fun p => wrapYield G h p.1.1 p.1.2
      (chosenYield G h p.2.1.1 p.2.1.2 ++
       chosenYield G h p.2.2.1 p.2.2.2))

noncomputable def WitnessEmpty (G : SSBNFGrammar Alphabet NT) :
    Finset (List Alphabet) :=
  if G.startEmpty = true then {[]} else ∅

/-- All four families combined, with duplicates automatically removed. -/
noncomputable def PositiveWitnesses (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) : Finset (List Alphabet) :=
  WitnessSymbols G h ∪ WitnessLexical G h ∪
    WitnessBinary G h ∪ WitnessEmpty G

theorem symbol_witness_mem (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) (A : NT) (μ : M)
    (ret : RetainedTypedSymbol G h A μ) :
    wrapYield G h A μ (chosenYield G h A μ) ∈
      PositiveWitnesses G h := by
  unfold PositiveWitnesses WitnessSymbols
  apply Finset.mem_union.mpr
  left
  apply Finset.mem_union.mpr
  left
  apply Finset.mem_union.mpr
  left
  exact Finset.mem_image.mpr
    ⟨(A,μ), (finite_symbols_iff G h A μ).mpr ret, rfl⟩

theorem lexical_witness_mem (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) (A : NT) (a : Alphabet)
    (rule : (A,a) ∈ G.terminalRules)
    (ret : RetainedTypedSymbol G h A (h [a])) :
    wrapYield G h A (h [a]) [a] ∈ PositiveWitnesses G h := by
  unfold PositiveWitnesses WitnessLexical
  apply Finset.mem_union.mpr
  left
  apply Finset.mem_union.mpr
  left
  apply Finset.mem_union.mpr
  right
  exact Finset.mem_image.mpr
    ⟨((A,h [a]),a),
      (finite_terminal_iff G h A (h [a]) a).mpr ⟨rule,rfl,ret⟩,
      rfl⟩

theorem binary_witness_mem (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) (A B C : NT)
    (μ ν : M)
    (rule : (A,B,C) ∈ G.binaryRules)
    (retA : RetainedTypedSymbol G h A (μ * ν))
    (retB : RetainedTypedSymbol G h B μ)
    (retC : RetainedTypedSymbol G h C ν) :
    wrapYield G h A (μ * ν)
       (chosenYield G h B μ ++ chosenYield G h C ν) ∈
      PositiveWitnesses G h := by
  unfold PositiveWitnesses WitnessBinary
  apply Finset.mem_union.mpr
  left
  apply Finset.mem_union.mpr
  right
  exact Finset.mem_image.mpr
    ⟨((A,μ*ν),(B,μ),(C,ν)),
      (finite_binary_iff G h A B C (μ*ν) μ ν).mpr
        ⟨rule,rfl,retA,retB,retC⟩,rfl⟩

theorem empty_witness_mem (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) (he : G.startEmpty = true) :
    ([] : List Alphabet) ∈ PositiveWitnesses G h := by
  unfold PositiveWitnesses WitnessEmpty
  apply Finset.mem_union.mpr
  right
  simp [he]

/-- Every element of the actual finite witness set is generated by G. -/
theorem positive_witnesses_subset_language (G : SSBNFGrammar Alphabet NT)
    (h : List Alphabet →* M) :
    (↑(PositiveWitnesses G h) : Set (List Alphabet)) ⊆
       GrammarLanguage G := by
  intro w hw
  change w ∈ PositiveWitnesses G h at hw
  unfold PositiveWitnesses at hw
  rcases Finset.mem_union.mp hw with h123 | h4
  · rcases Finset.mem_union.mp h123 with h12 | h3
    · rcases Finset.mem_union.mp h12 with h1 | h2
      · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp h1
        rcases p with ⟨A,μ⟩
        have hr := (finite_symbols_iff G h A μ).mp hp
        exact context_plug (chosenContext_spec hr) (chosenYield_spec hr)
      · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp h2
        rcases p with ⟨⟨A,μ⟩,a⟩
        obtain ⟨rule,ht,ret⟩ := (finite_terminal_iff G h A μ a).mp hp
        subst μ
        exact context_plug (chosenContext_spec ret)
          (TypedDerives.terminal rule)
    · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp h3
      rcases p with ⟨⟨A,τ⟩,⟨B,μ⟩,⟨C,ν⟩⟩
      obtain ⟨rule,ht,retA,retB,retC⟩ :=
        (finite_binary_iff G h A B C τ μ ν).mp hp
      subst τ
      exact context_plug (chosenContext_spec retA)
        (TypedDerives.binary rule
          (chosenYield_spec retB) (chosenYield_spec retC))
  · unfold WitnessEmpty at h4
    split at h4
    · have hnil : w = [] := by simpa using h4
      subst w
      exact StartDerives.empty (by assumption)
    · simp at h4

#print axioms TCSPhase5B.symbol_witness_mem
#print axioms TCSPhase5B.lexical_witness_mem
#print axioms TCSPhase5B.binary_witness_mem
#print axioms TCSPhase5B.positive_witnesses_subset_language
end TCSPhase5B
